# Azure Speech is required for speech synthesis.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_VOICE_NAME=en-US-JennyNeural

# Azure OpenAI is optional because preset fallback speech remains available.
ENABLE_LLM=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_MAX_WORDS=24
LLM_TIMEOUT_SECONDS=12

# Final single-plant profile.
PLANT_SPECIES=prayer plant / Maranta leuconeura
PRAYER_SOIL_VERY_DRY_RAW=650
PRAYER_SOIL_DRY_RAW=1000
PRAYER_SOIL_MOIST_RAW=1450
PRAYER_SOIL_WET_RAW=1850

# The deployed exhibition configuration used local playback and no MQTT.
PLANT_ID=plant1
UPDATE_INTERVAL_SECONDS=5
ENABLE_LOCAL_PLAYBACK=true
ENABLE_MQTT=false
MQTT_HOST=localhost
MQTT_PORT=1883
